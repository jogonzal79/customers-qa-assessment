{
  "info": {
    "name": "Customers API - QA Assessment",
    "description": "Pruebas de API de la app de clientes (Parte 2 del assessment).\n\nLos requests se ejecutan en orden y se encadenan: el alta del paso 01 guarda customerId, customerEmail y createStatusCode, que reutilizan los pasos siguientes. El email del alta es dinámico, por lo que la colección no depende de datos semilla ni de un endpoint de reset.\n\nLas carpetas R1, R2 y R3 corresponden a riesgos identificados en la Parte 1 (docs/01-test-cases.md). Sus resultados esperados siguen la especificación.\n\nRequiere la variable de entorno baseUrl.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "customerSchema",
      "value": "{\"type\":\"object\",\"required\":[\"id\",\"name\",\"email\",\"status\",\"created_at\"],\"additionalProperties\":false,\"properties\":{\"id\":{\"type\":\"integer\",\"minimum\":1},\"name\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":100},\"email\":{\"type\":\"string\",\"minLength\":3,\"maxLength\":254},\"status\":{\"type\":\"string\",\"enum\":[\"ACTIVE\",\"PENDING\",\"BLOCKED\"]},\"created_at\":{\"type\":\"string\",\"format\":\"date-time\"}}}"
    },
    {
      "key": "errorSchema",
      "value": "{\"type\":\"object\",\"required\":[\"error\"],\"properties\":{\"error\":{\"type\":\"object\",\"required\":[\"code\",\"message\"],\"properties\":{\"code\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"},\"details\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"required\":[\"field\",\"message\"],\"properties\":{\"field\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"}}}}}}}}"
    },
    {
      "key": "missingCustomerId",
      "value": "999999999"
    },
    {
      "key": "customerId",
      "value": ""
    },
    {
      "key": "customerName",
      "value": ""
    },
    {
      "key": "customerEmail",
      "value": ""
    },
    {
      "key": "customerEmailUpper",
      "value": ""
    },
    {
      "key": "createStatusCode",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Crear cliente válido [TC-01]",
      "description": "Requisito 1 del enunciado.",
      "item": [
        {
          "name": "POST /customers - alta válida",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/customers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "customers"
              ]
            },
            "description": "TC: TC-01\nEsperado: 201 Created, header Location /customers/{id}, body Customer con los datos enviados",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{customerName}}\",\n  \"email\": \"{{customerEmail}}\",\n  \"status\": \"ACTIVE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Email dinámico: la colección funciona sin reset y en un entorno real.",
                  "const unique = `${Date.now()}.${Math.floor(Math.random() * 10000)}`;",
                  "pm.collectionVariables.set(\"customerName\", \"Cliente QA Automatización\");",
                  "pm.collectionVariables.set(\"customerEmail\", `qa.auto.${unique}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Se guarda siempre, antes de los asserts: lo usa R3 [TC-14].",
                  "pm.collectionVariables.set(\"createStatusCode\", pm.response.code);",
                  "const body = pm.response.json();",
                  "if (body && body.id) { pm.collectionVariables.set(\"customerId\", body.id); }",
                  "",
                  "pm.test(\"Status code es 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Header Content-Type es application/json\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "});",
                  "pm.test(\"Body cumple el esquema Customer\", function () {",
                  "    pm.response.to.have.jsonSchema(JSON.parse(pm.collectionVariables.get(\"customerSchema\")));",
                  "});",
                  "pm.test(\"Header Location apunta al cliente creado\", function () {",
                  "    pm.response.to.have.header(\"Location\");",
                  "    pm.expect(pm.response.headers.get(\"Location\")).to.eql(`/customers/${body.id}`);",
                  "});",
                  "pm.test(\"Body devuelve los datos enviados\", function () {",
                  "    pm.expect(body.name).to.eql(pm.collectionVariables.get(\"customerName\"));",
                  "    pm.expect(body.email).to.eql(pm.collectionVariables.get(\"customerEmail\"));",
                  "    pm.expect(body.status).to.eql(\"ACTIVE\");",
                  "});",
                  "pm.test(\"created_at es una fecha ISO-8601 válida\", function () {",
                  "    pm.expect(Number.isNaN(Date.parse(body.created_at))).to.be.false;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
